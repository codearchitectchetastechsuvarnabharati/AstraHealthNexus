// Authentication uses PostgreSQL; telemetry/alert services still use memory/files.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TelemetryOrigin {
  collected
  submitted
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

// Intake accepts a mission identifier without requiring a full mission profile.
model Mission {
  id        String             @id @db.VarChar(100)
  telemetry MissionTelemetry[]
}

model MissionTelemetry {
  id            String          @id @default(uuid())
  source        String
  category      String
  mission       String          @db.VarChar(100)
  missionRecord Mission         @relation(fields: [mission], references: [id], onDelete: Restrict, onUpdate: Cascade)
  timestamp     DateTime        @db.Timestamptz(3)
  receivedAt    DateTime        @default(now()) @map("createdAt") @db.Timestamptz(3)
  origin        TelemetryOrigin
  values        Json            @map("payload")

  @@index([timestamp(sort: Desc), id])
  @@index([mission, timestamp(sort: Desc)])
  @@index([source, timestamp(sort: Desc)])
  @@index([category, timestamp(sort: Desc)])
}

model AlertEvent {
  // Generated by AlertService as alert_ + 64 lowercase hexadecimal characters.
  id             String      @id
  severity       String
  message        String
  source         String      @default("dashboard")
  status         AlertStatus @default(open)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime?   @db.Timestamptz(3)
  resolvedAt     DateTime?   @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([source, severity, createdAt(sort: Desc)])
}

enum UserRole {
  viewer
  operator
  admin
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique @db.VarChar(254)
  role         UserRole      @default(viewer)
  passwordHash String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  sessions     AuthSession[]
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}
